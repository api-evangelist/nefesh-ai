      {
        "name": "get_trigger_memory",
        "description": "Retrieve psychological trigger profile for a subject.\n\n    Returns which conversation topics consistently cause stress (active triggers) and which have been resolved over time.\n\n    - active triggers: topics where stress was elevated across multiple sessions. Tread carefully.\n    - resolved triggers: topics where stress has decreased. Safe to explore deeper.\n\n    Each trigger includes observation_count, avg_score, peak_score, and last_seen.\n\n    Requires prior ingest calls with the same subject_id. Not a medical device.\n    ",
        "inputSchema": {
          "properties": {
            "subject_id": {
              "title": "Subject Id",
              "type": "string"
            }
          },
          "required": [
            "subject_id"
          ],
          "title": "get_trigger_memoryArguments",
          "type": "object"
        }
      },
      {
        "name": "get_session_history",
        "description": "Get state history for a session over time.\n\n    Returns timestamped datapoints with stress_score, state, and heart_rate for each observation.\n    Includes an overall trend: rising | falling | stable.\n\n    Use minutes parameter to control the lookback window (default: 5, max: 60).\n    Useful for detecting stress patterns during a conversation. Not a medical device.\n    ",
        "inputSchema": {
          "properties": {
            "session_id": {
              "title": "Session Id",
              "type": "string"
            },
            "minutes": {
              "default": 5,
              "maximum": 60,
              "minimum": 1,
              "title": "Minutes",
              "type": "integer"
            }
          },
          "required": [
            "session_id"
          ],
          "title": "get_session_historyArguments",
          "type": "object"
        }
      },
      {
        "name": "delete_subject",
        "description": "Permanently delete all sessions and trigger memory for a subject.\n\n    Irreversible. Only call when the user explicitly requests this deletion.\n    ",
        "inputSchema": {
          "properties": {
            "subject_id": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Subject Id",
              "type": "string"
            }
          },
          "required": [
            "subject_id"
          ],
          "title": "delete_subjectArguments",
          "type": "object"
        },
        "annotations": {
          "destructiveHint": true,
          "idempotentHint": true
        }
      },
      {
        "name": "request_api_key",
        "description": "Start free API key authorization; no existing API key needed.\n\n    Returns a verification_url. Ask the user to open that URL in their\n    browser, enter their own email, then open the verification email and\n    confirm access for their agent. This tool\n    does not accept email addresses and does not send email.\n    Do not choose, invent, or submit an email on the user's behalf.\n    Poll check_api_key_status with the returned request_id at the supplied\n    interval. Stop if the request expires. Never create new requests in a loop.\n    ",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "title": "RequestKeyArguments",
          "type": "object"
        }
      },
      {
        "name": "check_api_key_status",
        "description": "Check a pending API key authorization using its request_id.\n\n    Use request_id exactly as returned by request_api_key, never an email.\n    Poll every 10 seconds. awaiting_user means the user must open the URL;\n    pending means email verification is still required. ready returns the\n    API key once only. Store it and include it in all subsequent HTTP calls.\n    Stop on expired; ask the user before starting another authorization.\n    ",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "title": "Request Id",
              "type": "string"
            }
          },
          "required": [
            "request_id"
          ],
